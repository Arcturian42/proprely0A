# Proprely — environment variables example
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In production (Vercel), set these via the project settings UI.

# ───────────────────────────────────────────────────────────────
# Supabase
# ───────────────────────────────────────────────────────────────
# When these are empty, the app runs in "dummy auth" mode (dev fallback).
# Set both to enable real auth, multi-tenant, magic-link signup/login.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by the signup API to create auth.users + companies.
# Never expose to the browser. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────────
# App
# ───────────────────────────────────────────────────────────────
# Public URL of this app (used in magic-link emailRedirectTo).
# Locally: http://localhost:3000
# Prod:    https://app.proprely.fr

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────
# Third-party integrations (existing in main)
# ───────────────────────────────────────────────────────────────

# SignNow e-signature (optional — quote/contract signing)
# - BASIC_TOKEN : base64("client_id:client_secret") for the OAuth bootstrap
# - API_KEY     : long-lived API key returned by SignNow once authenticated
# - CLIENT_ID   : SignNow account/entity id used when creating signing flows
SIGNNOW_BASIC_TOKEN=
SIGNNOW_API_KEY=
SIGNNOW_CLIENT_ID=

# Yousign e-signature (legacy, may be removed once SignNow is fully adopted)
YOUSIGN_API_KEY=
# Set to "true" to hit the Yousign sandbox (api-sandbox.yousign.app); anything
# else (or unset) targets production (api.yousign.app).
YOUSIGN_SANDBOX=false

# Resend — emails transactionnels (invitation, devis envoyé, mission assignée…)
# Créer une clé sur https://resend.com/api-keys
RESEND_API_KEY=
