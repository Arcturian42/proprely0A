# Proprely — environment variables example
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In production (Vercel), set these via the project settings UI.

# ───────────────────────────────────────────────────────────────
# Supabase
# ───────────────────────────────────────────────────────────────
# When these are empty, the app runs in "dummy auth" mode (dev fallback).
# Set both to enable real auth, multi-tenant, magic-link signup/login.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by the signup API to create auth.users + companies.
# Never expose to the browser. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────────
# App
# ───────────────────────────────────────────────────────────────
# Public URL of this app (used in magic-link emailRedirectTo).
# Locally: http://localhost:3000
# Prod:    https://app.proprely.fr

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────────
# Third-party integrations
# ───────────────────────────────────────────────────────────────

# Docuseal — e-signature (devis, contrats). Replaces SignNow + Yousign.
# Create a key at https://console.docuseal.com (API tab).
# Set DOCUSEAL_API_BASE only if you self-host Docuseal.
DOCUSEAL_API_KEY=
# DOCUSEAL_API_BASE=https://api.docuseal.com
# Shared HMAC secret used to verify webhook events on /api/docuseal/webhook.
# Set the same value in the Docuseal dashboard → Webhooks → Secret.
# Leave empty in dev to skip verification (NOT for production).
DOCUSEAL_WEBHOOK_SECRET=

# Resend — emails transactionnels (invitation, devis envoyé, mission assignée…)
# Créer une clé sur https://resend.com/api-keys
RESEND_API_KEY=
# Sender (laisse vide pour utiliser le sandbox Resend "onboarding@resend.dev").
# En prod, mets une adresse sur un domaine vérifié dans Resend.
# RESEND_FROM=Proprely <noreply@proprely.fr>

# Sentry — error + performance monitoring. DSN obtenu sur sentry.io.
# NEXT_PUBLIC_SENTRY_DSN est exposé au client (nécessaire pour Sentry browser).
# Format DSN : https://<publicKey>@o<orgId>.ingest.<region>.sentry.io/<projectId>
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Pour upload des source maps en CI (sinon stacks minifiées en prod) :
# Token : sentry.io → Settings → Auth Tokens, scopes project:read+releases+write, org:read
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=pgs-eu
# SENTRY_PROJECT=proprely-admin

# PostHog — analytics produit (funnels, retention). Optionnel.
# Clé sur https://eu.posthog.com (project settings).
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
