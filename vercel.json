{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/mission-alerts?mode=reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/mission-alerts?mode=late",
      "schedule": "*/15 8-19 * * 1-6"
    },
    {
      "path": "/api/cron/recurrences",
      "schedule": "0 4 * * *"
    }
  ]
}
